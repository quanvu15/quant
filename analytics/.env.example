# ============================================================
# Analytics Microservice — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Service identity ──────────────────────────────────────────
SERVICE_NAME=analytics
VERSION=1.0.0
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=["*"]

# ── Database ─────────────────────────────────────────────────
# Shared Postgres database with QuantDinger.
# Analytics only accesses schema "analytics.*" (schema isolation).
# Credentials/port MUST match QD_Backend's DATABASE_URL.
# QD uses: postgresql://quantdinger:quantdinger123@localhost:5435/quantdinger
# Analytics uses asyncpg driver prefix:
DATABASE_URL=postgresql+asyncpg://quantdinger:quantdinger123@localhost:5435/quantdinger
DB_SCHEMA=analytics

# PostgreSQL connection details (used by docker-compose postgres service)
POSTGRES_USER=quantdinger
POSTGRES_PASSWORD=quantdinger123
POSTGRES_DB=quantdinger
POSTGRES_PORT=5435

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_PORT=6379

# Prefix for all Redis keys/channels written by Analytics.
# Keep "analytics:" so we never collide with QuantDinger ("qd:").
REDIS_KEY_PREFIX=analytics:

# ── Auth (Analytics-native JWT) ───────────────────────────────
# CHANGE THIS in production — use a long random string!
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Master API key for admin/dev (optional — leave empty in production)
MASTER_API_KEY=

# ── QuantDinger JWT Bridge ────────────────────────────────────
# Shared secret with QuantDinger Flask backend. MUST match the
# Flask SECRET_KEY so JWTs issued by QD can be verified by Analytics.
# Leave empty to disable the JWT bridge (Analytics will only accept
# its own JWTs / API keys).
QUANTDINGER_JWT_SECRET=
QUANTDINGER_JWT_ALGORITHM=HS256

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_FREE=60
RATE_LIMIT_PAID=600

# ── Python Runner ─────────────────────────────────────────────
# SCRIPTS_DIR: path to fincept-qt/scripts/
# Auto-detected if empty (searches ../fincept-qt/scripts/ from project root).
# Set absolute path if auto-detect fails:
# Windows: SCRIPTS_DIR=G:\Code\AI-APP\FinceptTerminal\fincept-qt\scripts
# Linux:   SCRIPTS_DIR=/opt/fincept/fincept-qt/scripts
SCRIPTS_DIR=

# VENV_NUMPY2_PYTHON: Python interpreter with full script dependencies
# (numpy, pandas, agno, qlib, torch, etc.)
# Auto-detected if empty (searches ../fincept-qt/venv-numpy2/).
# Windows: VENV_NUMPY2_PYTHON=G:\Code\AI-APP\FinceptTerminal\fincept-qt\venv-numpy2\Scripts\python.exe
# Linux:   VENV_NUMPY2_PYTHON=/opt/fincept/fincept-qt/venv-numpy2/bin/python
VENV_NUMPY1_PYTHON=
VENV_NUMPY2_PYTHON=

DEFAULT_VENV=venv-numpy2
MAX_CONCURRENT_PROCESSES=5
DEFAULT_TIMEOUT=60

# ── Agent Timeouts ────────────────────────────────────────────
AGENT_RUN_TIMEOUT=120
AGENT_PLAN_TIMEOUT=300
MAX_CONCURRENT_AGENT_RUNS=10

# ── News Fetcher ──────────────────────────────────────────────
# Interval between RSS fetch cycles (seconds)
NEWS_FETCH_INTERVAL=30
# Consecutive errors before a source is auto-disabled
NEWS_SOURCE_ERROR_THRESHOLD=5
# Per-source fetch timeout (seconds)
NEWS_FETCH_TIMEOUT=10
# Audit log retention in days
AUDIT_LOG_RETENTION_DAYS=90

# ── External API Keys ─────────────────────────────────────────
# These are injected into Python subprocess environments.
# Scripts can also receive keys per-request via request body.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
MARINETRAFFIC_API_KEY=
ACLED_API_KEY=
HELIUS_API_KEY=

# ── LLM Defaults (OpenAI-compatible) ─────────────────────────
# Server-side default — used when client does not pass llm_config.
# Default provider is NOT "fincept" — configure your own endpoint.
# Change base_url to use Groq, Together, Ollama, LM Studio, etc.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Examples of OpenAI-compatible providers:
# Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-70b-versatile
# Together:  LLM_BASE_URL=https://api.together.xyz/v1       LLM_MODEL=meta-llama/Llama-3-70b-chat-hf
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1       LLM_MODEL=deepseek-chat
# Ollama:    LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.2  LLM_API_KEY=ollama
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1           LLM_MODEL=local     LLM_API_KEY=lm-studio

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console   # json | console
